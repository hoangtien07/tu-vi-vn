# PostgreSQL (docker-compose fills from this)
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tuvi

# AI endpoint — OpenAI-compatible, self-hosted (SPEC §14)
AI_BASE_URL=http://localhost:8001/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=60

# Web → proxy port
PORT=8080
