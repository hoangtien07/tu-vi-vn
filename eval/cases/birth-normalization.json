{
  "gate": "A",
  "description": "Birth-time normalization boundary corpus (EVALUATION.md Gate A). Each case: input = RawBirthInput fields; expect = assertions on NormalizedBirthMoment or expected error. `error: \"validation\"` = pydantic reject (API 422); other error values = domain exception class names.",
  "cases": [
    {"id": "bn-001", "note": "south +07 normal era",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "14:30", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420, "timeIndex": 7, "provisional": false}},
    {"id": "bn-002", "note": "north pre-1954-10 switch → +08",
     "input": {"calendar": "solar", "date": "1947-04-01", "time": "10:00", "gender": "male", "birthRegion": "north", "trueSolarTimeEnabled": false},
     "expect": {"offset": 480, "timeIndex": 5}},
    {"id": "bn-003", "note": "north ambiguous October-1954 boundary → +07 + warning",
     "input": {"calendar": "solar", "date": "1954-10-15", "time": "10:00", "gender": "male", "birthRegion": "north", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420, "warningsHas": "ambiguous"}},
    {"id": "bn-004", "note": "north after Nov 1954 → +07, no warning",
     "input": {"calendar": "solar", "date": "1954-11-15", "time": "10:00", "gender": "male", "birthRegion": "north", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420}},
    {"id": "bn-005", "note": "south before 1955-07 switch → +08",
     "input": {"calendar": "solar", "date": "1955-06-15", "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 480}},
    {"id": "bn-006", "note": "south at 1955-07-01 switch day → +07",
     "input": {"calendar": "solar", "date": "1955-07-01", "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420}},
    {"id": "bn-007", "note": "south 1959-12-31 (last +07 day pre-1960) → +07",
     "input": {"calendar": "solar", "date": "1959-12-31", "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420}},
    {"id": "bn-008", "note": "south 1960-01-01 boundary → +08",
     "input": {"calendar": "solar", "date": "1960-01-01", "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 480}},
    {"id": "bn-009", "note": "south 1975-06-12 22:00 (still +08) → +08",
     "input": {"calendar": "solar", "date": "1975-06-12", "time": "22:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 480}},
    {"id": "bn-010", "note": "south 1975-06-13 (after unification switch) → +07",
     "input": {"calendar": "solar", "date": "1975-06-13", "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"offset": 420}},
    {"id": "bn-011", "note": "divergence window (a) 1954-10→1955-07 without birthRegion → block",
     "input": {"calendar": "solar", "date": "1955-03-10", "time": "10:00", "gender": "male", "trueSolarTimeEnabled": false},
     "expect": {"error": "BirthRegionRequiredError"}},
    {"id": "bn-012", "note": "divergence window (b) 1960→1975-06-12 without birthRegion → block",
     "input": {"calendar": "solar", "date": "1970-05-05", "time": "10:00", "gender": "male", "trueSolarTimeEnabled": false},
     "expect": {"error": "BirthRegionRequiredError"}},
    {"id": "bn-013", "note": "central follows south rules (divergence window (b), explicit central)",
     "input": {"calendar": "solar", "date": "1970-05-05", "time": "10:00", "gender": "male", "birthRegion": "central", "trueSolarTimeEnabled": false},
     "expect": {"offset": 480}},
    {"id": "bn-014", "note": "23:00 → timeIndex 12 (Tý muộn; no day roll in normalizer)",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "23:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"timeIndex": 12, "correctedSolarDate": "1990-06-15"}},
    {"id": "bn-015", "note": "23:59 → timeIndex 12",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "23:59", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"timeIndex": 12}},
    {"id": "bn-016", "note": "00:00 → timeIndex 0 (Tý sớm)",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "00:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"timeIndex": 0}},
    {"id": "bn-017", "note": "00:59 → 0; 01:00 → 1 (boundary)",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "01:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"timeIndex": 1}},
    {"id": "bn-018", "note": "timeUnknown → provisional + VN warning",
     "input": {"calendar": "solar", "date": "1990-06-15", "timeUnknown": true, "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"provisional": true, "warningsHas": "tạm thời"}},
    {"id": "bn-019", "note": "trueSolarTimeEnabled without longitude → block",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "14:30", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": true},
     "expect": {"error": "SolarCoordinateRequiredError"}},
    {"id": "bn-020", "note": "trueSolar Đà Nẵng 108.2°E → +12.6min correction, same day",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "14:30", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": true, "longitude": 108.2},
     "expect": {"normalizationMode": "true-solar", "timeIndex": 7, "correctedSolarDate": "1990-06-15"}},
    {"id": "bn-021", "note": "trueSolar west-edge 102.6°E + negative EoT → rolls to previous day, late-Tý",
     "input": {"calendar": "solar", "date": "1990-02-09", "time": "00:10", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": true, "longitude": 102.6},
     "expect": {"correctedSolarDate": "1990-02-08", "timeIndex": 12}},
    {"id": "bn-022", "note": "leapMonth=true on non-leap lunar month → block (engine silent-ignores, we must not)",
     "input": {"calendar": "lunar", "date": "2020-05-05", "leapMonth": true, "time": "10:00", "gender": "male", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"error": "NotLeapMonthError"}},
    {"id": "bn-023", "note": "valid leap month: lunar 2020-04-15 leap → solar 2020-06-06",
     "input": {"calendar": "lunar", "date": "2020-04-15", "leapMonth": true, "time": "10:00", "gender": "female", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"correctedSolarDate": "2020-06-06", "timeIndex": 5}},
    {"id": "bn-024", "note": "lunar regular month 2020-04-01 → solar 2020-04-23",
     "input": {"calendar": "lunar", "date": "2020-04-01", "leapMonth": false, "time": "10:00", "gender": "female", "birthRegion": "south", "trueSolarTimeEnabled": false},
     "expect": {"correctedSolarDate": "2020-04-23"}},
    {"id": "bn-025", "note": "unsupported timezone → validation (422)",
     "input": {"calendar": "solar", "date": "1990-06-15", "time": "10:00", "gender": "male", "timezone": "America/New_York"},
     "expect": {"error": "validation"}},
    {"id": "bn-026", "note": "solar year 1500 below engine range → validation (422)",
     "input": {"calendar": "solar", "date": "1500-01-01", "time": "10:00", "gender": "male"},
     "expect": {"error": "validation"}},
    {"id": "bn-027", "note": "time missing while timeUnknown=false → validation (422)",
     "input": {"calendar": "solar", "date": "1990-06-15", "gender": "male"},
     "expect": {"error": "validation"}}
  ]
}
